# Copy to .env and fill in. .env is gitignored.

# Required. At least 32 bytes: it signs both session cookies and auth tokens.
SECRET_KEY=

# Optional. Local SQLite is used when unset, which is what you want for
# development — a remote database makes every query a network round trip.
# DATABASE_URL=postgresql://...

# Optional. Origins allowed to call the API with credentials.
# CORS_ORIGINS=http://localhost:5173

# Cloudflare R2. Leave all of these unset and uploads go to server/media/
# on local disk instead, which needs no account and no credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public base URL clips are served from: your custom domain connected to the
# bucket, e.g. https://clips.example.com
# R2_PUBLIC_BASE_URL=
